generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Tabel Induk untuk Data Pasien
model Patient {
  id                  String                @id @default(uuid())
  medicalRecordNumber String?               @unique
  name                String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  // Relasi One-to-Many ke hasil prediksi
  mortalityPredictions MortalityPrediction[]
  losPredictions       LosPrediction[]
}

// Tabel 1: Output Model Mortalitas
model MortalityPrediction {
  id                 String   @id @default(uuid())
  patientId          String
  patient            Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  // Data Input
  featuresInput      Json     // Menyimpan seluruh payload input dari frontend dalam format JSON

  // Data Output (Sesuai dengan payload respons predict.py)
  probability        Float    // Menyimpan nilai "probability"
  predictedClass     Int      // Menyimpan nilai "predicted_class"
  baseValue          Float    // Menyimpan nilai "base_value"
  shapContributions  Json     // Menyimpan array "shap_contributions"

  createdAt          DateTime @default(now())
}

// Tabel 2: Output Model Lama Rawat (Length of Stay)
model LosPrediction {
  id                 String   @id @default(uuid())
  patientId          String
  patient            Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  // Data Input
  featuresInput      Json     // Menyimpan seluruh payload input dari frontend
  meldScore          Float    // Menyimpan nilai kalkulasi dinamis MELD dari backend

  // Data Output (Sesuai dengan payload respons predict_los.py)
  probabilityLos     Float    // Menyimpan nilai "probability_los"

  createdAt          DateTime @default(now())
}